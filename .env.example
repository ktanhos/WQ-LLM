# Thông tin đăng nhập WorldQuant BRAIN. Tệp .env đã nằm trong .gitignore.
BRAIN_EMAIL=dia_chi_thu_dien_tu_cua_ban
BRAIN_PASSWORD=mat_khau_cua_ban
BRAIN_API_BASE=https://api.worldquantbrain.com

# Đường dẫn kho dữ liệu và tệp cấu hình.
ALPHAFORGE_DB=data/alphaforge.sqlite3
ALPHAFORGE_CONFIG=config/settings.yaml

# Mô hình ngôn ngữ là tùy chọn. Bỏ trống thì mọi chức năng khác vẫn chạy đủ.
# Giá trị hợp lệ: none, claude, ollama.
ALPHAFORGE_LLM_PROVIDER=none
# ALPHAFORGE_LLM_MODEL=
# Khóa Claude chỉ đọc từ biến môi trường, không bao giờ từ tệp cấu hình.
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
